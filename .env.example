# CommandIA Environment Configuration
# Copy this to .env and fill in your values

# Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Meta/WhatsApp/Instagram (for future webhook integration)
META_VERIFY_TOKEN=your_verify_token_here
META_APP_SECRET=your_app_secret_here
META_ACCESS_TOKEN=your_access_token_here

# Supabase (for future database integration)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# App settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
