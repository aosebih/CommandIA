# CommandIA Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# --- Gemini API (required) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model. gemini-2.5-flash returns 404 for new API keys
# ("no longer available to new users"), so a 3.x model is the default.
# gemini-3.5-flash-lite is the fastest option (~2s) and the one used for
# extraction; gemini-3.5-flash is the stronger fallback.
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma separated list, tried in order when the primary model fails.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash

# Retries and backoff for transient provider errors (429 / 5xx).
MAX_RETRIES=3
RETRY_BASE_DELAY=2.0
# The free tier allows 15 requests/minute per model and answers 429 with the
# delay it expects ("Please retry in 15.5s"). That delay is used when it is
# longer than the exponential backoff, up to this cap.
RETRY_MAX_DELAY=60

# --- Meta Graph API (Instagram / Facebook DMs) ---
# META_VERIFY_TOKEN: the token you set in the Meta developer dashboard.
# META_APP_SECRET: the app secret, used to verify the X-Hub-Signature-256 header.
# META_ACCESS_TOKEN: the page access token used to send replies.
# META_PAGE_ID: optional, only needed to reply as a Facebook Page.
META_VERIFY_TOKEN=your_verify_token_here
META_APP_SECRET=your_app_secret_here
META_ACCESS_TOKEN=your_access_token_here
META_PAGE_ID=your_page_id_here
META_GRAPH_API_VERSION=v21.0

# --- Supabase (optional) ---
# When both values are real, extracted orders are written to the orders table.
# Use the service role key on the API. Leave placeholders to disable persistence.
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
SUPABASE_ORDERS_TABLE=orders
SUPABASE_ORDER_ITEMS_TABLE=order_items
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_MESSAGES_TABLE=messages
SUPABASE_PRODUCTS_TABLE=products
SUPABASE_MERCHANTS_TABLE=merchants
SUPABASE_SHIPPING_TABLE=shipping_rates
# UUID of the demo merchant row created by backend/seed.sql
DEFAULT_MERCHANT_ID=your_merchant_id_here

# --- Service ---
# Shared secret for the POST /chat development endpoint.
# Leave the placeholder to disable that endpoint.
COMMANDIA_API_KEY=your_api_key_here

# Dashboard (Next.js). The UI calls FastAPI with COMMANDIA_API_KEY.
DASHBOARD_ORIGIN=http://localhost:3000

HOST=0.0.0.0
PORT=8000
DEBUG=False
